APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# البريد: للتطوير MAIL_MAILER=log (يُكتب البريد في اللوق). للإنتاج ضعه resend + مفتاح Resend أدناه.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@salasel.sa"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (resend.com) — إرسال البريد (تحقّق البريد، إشعارات الاجتماعات...). النطاق يجب توثيقه في Resend.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# المساعد القانوني الذكي — الأولوية: Gemini (Google) ← GLM (z.ai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GLM_API_KEY=
GLM_MODEL=glm-4.6
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Zoom (Server-to-Server OAuth) — اجتماعات الاستشارات المرئية. بلا مفاتيح يعمل الرابط الاحتياطي.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Moyasar (بوّابة الدفع) — من dashboard.moyasar.com. بلا مفاتيح يبقى الدفع محاكى.
# sk_test_/pk_test_ للتجربة، sk_live_/pk_live_ للإنتاج. secret_key خادميّ لا يُسرَّب.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# تقنيات (taqnyat.sa) — واجهة Verify الرسميّة لرمز التحقّق (OTP): POST /verify.php (تقنيات تُولّد وتتحقّق).
# API_KEY من قسم المطوّرين (Application) في حسابك، وSENDER اسم المُرسِل المعتمد. بلا مفاتيح تُمنع المصادقة (لا محاكاة).
TAQNYAT_API_KEY=
TAQNYAT_SENDER=
TAQNYAT_BASE_URL=https://api.taqnyat.sa
# نقطة الرسائل النصّية (تذكير الاستشارة قبل 30 دقيقة) — غير verify.php الخاصّة بالـOTP
TAQNYAT_SMS_ENDPOINT=/v1/messages

# ⚠️ تجاوز تطويريّ مؤقّت: رمز OTP ثابت للدخول عند تعطّل المزوّد (غير الإنتاج فقط). اتركه فارغاً للإنتاج.
AUTH_DEV_OTP=

# ══════════════════════════════════════════════════════════════════════
# متغيّرات خاصّة بالمشروع (كانت غير موثّقة — القيم أدناه هي الافتراضات الفعليّة)
# ══════════════════════════════════════════════════════════════════════

# بيانات المكتب — تظهر على المواعيد الحضورية وروابط الخرائط وملفات التقويم.
OFFICE_CITY="الرياض"
OFFICE_ADDRESS="الرياض — حي العليا"

# ⚠️ تصفير قاعدة البيانات من لوحة الإدارة. محظور في الإنتاج افتراضياً — لا تفتحه إلا مؤقّتاً.
ALLOW_DB_RESET=false

# توليد PDF: auto يجرّب كروم (browsershot) ثم يسقط إلى المولّد الأصلي.
# المهلة بالثواني، وتُبقَى دون max_execution_time لخادم الويب.
PDF_ENGINE=auto
PDF_TIMEOUT=20

# Zoom Meeting SDK — للانضمام داخل الصفحة (مستقلّ عن مفاتيح Server-to-Server أعلاه).
# fallback_base: الرابط البديل حين لا تُضبط مفاتيح Zoom إطلاقاً.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
# ZOOM_FALLBACK_BASE=https://salaselbabel.net/   ← معطّل: الإعداد بلا مناد في الكود

# الوكيل الذكي للتذاكر — التصنيف والفرز التلقائي. cooldown بالدقائق بين ردّين آليين.
AI_TICKET_AGENT=true
AI_COOLDOWN_MINUTES=30

# Moyasar — عنوان الواجهة (يُغيَّر للبيئات التجريبية فقط).
MOYASAR_BASE_URL=https://api.moyasar.com/v1

# Reverb — خادم البثّ الحيّ (المحادثات وتحديثات المراحل لحظياً).
# للإنتاج: BROADCAST_CONNECTION=reverb أعلاه + REVERB_HOST نطاقك + SCHEME=https + PORT=443.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
