APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# البريد: للتطوير MAIL_MAILER=log (يُكتب البريد في اللوق). للإنتاج ضعه resend + مفتاح Resend أدناه.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@salasel.sa"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (resend.com) — إرسال البريد (تحقّق البريد، إشعارات الاجتماعات...). النطاق يجب توثيقه في Resend.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# المساعد القانوني الذكي — الأولوية: Gemini (Google) ← GLM (z.ai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GLM_API_KEY=
GLM_MODEL=glm-4.6
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Zoom (Server-to-Server OAuth) — اجتماعات الاستشارات المرئية. بلا مفاتيح يعمل الرابط الاحتياطي.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Moyasar (بوّابة الدفع) — من dashboard.moyasar.com. بلا مفاتيح يبقى الدفع محاكى.
# sk_test_/pk_test_ للتجربة، sk_live_/pk_live_ للإنتاج. secret_key خادميّ لا يُسرَّب.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# تقنيات (taqnyat.sa) — واجهة Verify الرسميّة لرمز التحقّق (OTP): POST /verify.php (تقنيات تُولّد وتتحقّق).
# API_KEY من قسم المطوّرين (Application) في حسابك، وSENDER اسم المُرسِل المعتمد. بلا مفاتيح تُمنع المصادقة (لا محاكاة).
TAQNYAT_API_KEY=
TAQNYAT_SENDER=
TAQNYAT_BASE_URL=https://api.taqnyat.sa

# ⚠️ تجاوز تطويريّ مؤقّت: رمز OTP ثابت للدخول عند تعطّل المزوّد (غير الإنتاج فقط). اتركه فارغاً للإنتاج.
AUTH_DEV_OTP=
